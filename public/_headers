# Cloudflare Pages response headers.
# Hashed build output never changes under its name.
/build/*
  Cache-Control: public, max-age=31536000, immutable

# Models, clips, audio and cards keep stable names across re-optimisation:
# cache for a day, then revalidate (the service worker keeps them offline).
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The page and the service worker must always be fresh.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
